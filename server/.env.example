# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173

# JWT Secret for Session Authentication (minimum 32 characters)
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Firebase Admin Configuration (Project ID and Service Account)
FIREBASE_PROJECT_ID=interviewiq-b31e1
# Optional: Path to service account JSON key file, or inline JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"interviewiq-b31e1",...}

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interviewiq?retryWrites=true&w=majority

# Google Gemini API Key (obtained from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
